# Copy to mobile/.env (never commit .env). Same values as web/.env with EXPO_PUBLIC_ prefix.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Hosted web app URL — used for Privacy / Terms links (required for App Store).
# Example: https://medicine-tracker-one-eta.vercel.app
EXPO_PUBLIC_WEB_APP_URL=https://YOUR-VERCEL-URL.vercel.app

# Optional: free Google Gemini API key for smarter pharmacy label parsing (text only).
# Get one at https://aistudio.google.com/apikey
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
